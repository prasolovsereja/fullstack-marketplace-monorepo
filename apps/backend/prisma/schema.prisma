// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          Int       @id@default(autoincrement())
  email       String    @unique
  password    String
  role        Role      @default(BUYER)
  createdAt   DateTime  @default(now())
  products    Product[] @relation("SellerProducts")
  sessions    Session[] @relation("UserSessions")
  buyerOrders BuyerOrder[] @relation("BuyerOrders")
  sellerOrders SellerOrder[] @relation("SellerOrders")
}

enum Role {
  BUYER
  SELLER
  ADMIN
}

model Product {
  id            Int @id@default(autoincrement())
  title         String
  description   String?
  price         Int
  quantity      Int
  seller        User @relation("SellerProducts",fields: [sellerId], references: [id])
  sellerId      Int
  categories    Category[]  @relation("ProductsCategories")
  orderItems     OrderItem[]
  deliveryProfileId Int
  deliveryProfile   DeliveryProfile @relation("DeliveryProfile", fields: [deliveryProfileId], references: [id])
}

model Category {
  id            Int @id@default(autoincrement())
  name          String @unique
  isFeatured    Boolean @default(false)
  products      Product[] @relation("ProductsCategories")

}

model Session {
  id            Int @id@default(autoincrement())
  userId        Int
  user          User @relation("UserSessions", fields: [userId], references: [id])
  deviceLabel   Labels
  refreshToken  RefreshToken[] @relation("Session tokens")
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime
  revokedAt     DateTime?
}

model RefreshToken {
  id            Int @id@default(autoincrement())
  sessionId     Int
  tokenHash     String @unique
  session       Session @relation("Session tokens", fields: [sessionId], references: [id])
  expiresAt     DateTime
  replacedById  Int?
  replacedBy    RefreshToken? @relation("TokenReplace", fields: [replacedById], references: [id])
  replaced      RefreshToken[] @relation("TokenReplace")
  updatedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([sessionId, replacedById])
}

enum Labels {
  userPc
  userPhone
  guest
  unknown
}

model OrderItem {
  id              Int @id@default(autoincrement())
  productId       Int
  product         Product @relation(fields: [productId], references: [id])
  buyerId         Int
  sellerId        Int
  price           Int
  quantity        Int
  deliveryGroupId Int
  deliveryGroup   DeliveryGroup @relation(fields: [deliveryGroupId], references: [id])
  sellerOrderId   Int
  sellerOrder     SellerOrder @relation(fields: [sellerOrderId], references: [id])
}

model SellerOrder {
  id            Int @id@default(autoincrement())
  orderItems    OrderItem[]
  sellerId      Int
  seller        User @relation("SellerOrders", fields: [sellerId], references: [id])
  purchaseDate  DateTime @default(now())
}
model BuyerOrder {
  id              Int @id@default(autoincrement())
  buyerId         Int
  buyer           User @relation("BuyerOrders", fields: [buyerId], references: [id])
  totalPrice      Int
  deliveryGroups  DeliveryGroup[] @relation("OrderGroups")
  purchaseDate    DateTime @default(now())
}
model DeliveryGroup {
  id Int @id@default(autoincrement())
  items OrderItem[]
  orderId Int
  order BuyerOrder @relation("OrderGroups", fields: [orderId], references: [id])
  deliveryDate DateTime
}

model DeliveryProfile {
  id    Int @id@default(autoincrement())
  name  String
  code  String @unique
  dayWeight Json
  products Product[] @relation("DeliveryProfile")
}
